CONFIG_IDF_TARGET="esp32s3"

# ---- T-Dongle-S3: 16 MB quad flash, no PSRAM (LILYGO boards/dongles3.json) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# ---- Console ----
# The native USB is used by TinyUSB, so the USB-Serial/JTAG console is gone.
# Primary console stays on UART0 (GPIO43/44 = QWIIC connector); logs are also
# available on the TinyUSB CDC port and via http://<ip>/api/log.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- Protect bootloader / partition table from accidental flash writes ----
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ABORTS=y

# ---- TinyUSB: MSC + CDC (log port; disable CDC for printer tests if needed) ----
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="WiFi DataDrive"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="DataDrive"
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
CONFIG_TINYUSB_DESC_CDC_STRING="DataDrive Log"
CONFIG_TINYUSB_DESC_MSC_STRING="DataDrive Disk"

# ---- Wear levelling: 512 byte sectors (best host compatibility, as in Espressif's
# tusb_msc example) in SAFE mode (power-loss safe; Espressif's example uses PERF).
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_SAFE=y

# ---- FAT ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_USE_LABEL=y

# ---- HTTP ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# ---- Wi-Fi / lwIP throughput for uploads (moderate, no PSRAM) ----
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# ---- Clock (components/pd_time): NTP server from DHCP (option 42) plus pool.ntp.org ----
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# ---- Optional HTTPS for the web UI (setting, off by default; see main/tls.h) ----
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
# Static TLS record buffers: allocated once per connection, never per record. The dynamic
# variant (0.4.0) needed a fresh 16.7 KB block for every incoming record and failed on the
# fragmented heap. Only TLS uses this; nothing changes while HTTPS is off.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# Incoming records can be 16 KB (browsers do not negotiate smaller ones); the server itself
# sends records of at most 4 KB.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# mbedTLS allocates with calloc()/free() (on this board without PSRAM the same internal RAM as
# the default "internal memory" mode); while HTTPS runs, tls.c installs an allocator that hands
# out the two record buffers reserved at boot (pd_tls_reserve_buffers()).
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y

# ---- OTA: new firmware must confirm itself (ota_init), otherwise the bootloader rolls back ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
