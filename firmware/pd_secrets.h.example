// Vorlage für lokale WLAN-Zugangsdaten (Standardwerte für pd_wifi).
//
// Benutzung:
//   1. Diese Datei nach firmware/pd_secrets.h kopieren
//        copy firmware\pd_secrets.h.example firmware\pd_secrets.h
//   2. SSID und Passwort unten eintragen.
//   3. firmware/pd_secrets.h ist in .gitignore eingetragen und darf NICHT
//      eingecheckt werden.
//   4. Sauber neu bauen, damit pd_wifi die neue Datei sieht (pd_wifi.c prüft
//      per __has_include, ob sie existiert - das erkennt der inkrementelle
//      Build nicht zuverlässig):
//        .\tools\idf.ps1 printdrive fullclean
//        .\tools\idf.ps1 printdrive build
//      (oder den Ordner firmware\printdrive\build löschen).
//
// Vorrang: Zugangsdaten, die über die Weboberfläche gesetzt wurden (im NVS
// gespeichert), haben Vorrang vor diesen Werten. Die Werte hier gelten nur,
// solange im NVS nichts hinterlegt ist (z. B. nach dem ersten Flashen oder
// nach dem Löschen des NVS).
#pragma once

#define PD_WIFI_SSID "MeinWLAN"
#define PD_WIFI_PASS "MeinPasswort"
