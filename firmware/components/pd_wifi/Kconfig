menu "DataDrive Wi-Fi"

    config PD_WIFI_HOSTNAME
        string "Default hostname (DHCP and mDNS)"
        default "datadrive"
        help
            The web interface is reachable as http://<hostname>.local where mDNS works.
            Default only: the hostname can be changed in the web UI (stored in NVS) and goes
            back to this value when the button is held for 10 s. Use 1-31 characters a-z,
            0-9 and '-' (not first or last); anything else falls back to "datadrive".

    config PD_WIFI_AP_FALLBACK_S
        int "Start setup access point after this many seconds without connection"
        default 20
        range 5 600

    config PD_WIFI_AP_LINGER_S
        int "Keep setup access point on for this many seconds after the station connected"
        default 120
        range 10 3600

    config PD_WIFI_CAPTIVE_PORTAL
        bool "Captive portal on the setup access point"
        default y
        help
            While the setup access point is on, a small DNS responder answers every name with
            the access point's address, so phones and laptops open the setup page by themselves
            (the web server redirects their connectivity checks). Costs no task and no socket.

    config PD_WIFI_CAPTIVE_DHCP_URI
        bool "Announce the setup page via DHCP option 114 (RFC 8910)"
        depends on PD_WIFI_CAPTIVE_PORTAL
        default y
        help
            Sends http://<ap-ip>/ as captive portal URI. iOS and Android only use this option
            with an https URL and otherwise fall back to their connectivity checks; switch it
            off if a client misbehaves with it.

endmenu
