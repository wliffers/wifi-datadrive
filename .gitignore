# ESP-IDF build output and generated config (sdkconfig.defaults stays tracked)
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
# Downloaded by the component manager; dependencies.lock stays tracked for reproducible builds
firmware/*/managed_components/

# Local Wi-Fi credentials (template: firmware/pd_secrets.h.example)
firmware/pd_secrets.h

# Signing keys for firmware updates (docs/17_signierte_updates.md). The private key lives
# OUTSIDE the repository (default %USERPROFILE%\.datadrive\ota_signing_key.pem); these patterns
# are only a safety net against copying it in by mistake. The generated key-path overlay of the
# signed build lies in firmware/printdrive/build_signed/ (covered by build_*/ below).
*.pem
*.key
*.p12
*.pfx
sdkconfig.signing_key

# Flash dumps are large and device-specific; backup/SHA256SUMS.txt stays tracked
backup/*.bin

# Python
__pycache__/
*.pyc

# Editor: local VS Code settings, shared extension recommendations stay tracked
.vscode/*
!.vscode/extensions.json

# Diagnostic build (console on USB-Serial/JTAG)
firmware/*/build_diag/

# Per-package build folders
firmware/*/build_*/

# ---- Added for publication ----
# Wi-Fi credentials anywhere, local environment files
**/pd_secrets.h
.env
.env.*
# Private keys (update signing keys stay on the owner's machine, never in git)
*.key
*private*.pem
*_priv.pem
secrets/
# Outputs of the release scripts when run locally (.github/scripts)
/dist/
/stage/
/site/
# The browser flasher gets its firmware from the release at deploy time
web-flasher/firmware/
# Python virtual environments
.venv/
venv/
# Logs (e.g. of a local mock server run)
*.log
# Editors and operating systems
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
